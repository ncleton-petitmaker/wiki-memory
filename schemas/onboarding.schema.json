{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "onboarding.schema.json",
  "title": "Wiki Memory onboarding specification",
  "type": "object",
  "required": ["name", "language", "vaults"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "client_isolation": {"type": "boolean", "default": false},
    "sync_enabled": {"type": "boolean", "default": false},
    "versioning_confirmed": {"type": "boolean", "default": false},
    "connectors": {"type": "object"},
    "schedules": {"type": "object"},
    "vaults": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "./vault.schema.json"}
    }
  },
  "additionalProperties": false
}
